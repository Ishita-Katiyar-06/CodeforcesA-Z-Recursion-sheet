import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s= new Scanner(System.in);
        int num=s.nextInt();
        System.out.println(fac(num));
    }
    private static long fac(int num){
        if(num==1)return 1;
        return num*fac(num-1);
    }
}
