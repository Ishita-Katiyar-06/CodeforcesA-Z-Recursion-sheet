import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s= new Scanner(System.in);
        int n=s.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextInt();
        }
        leftMax(arr,1,n);
        for(int i=0;i<n;i++){
            System.out.print(arr[i]+" ");
        }
    }
    private static void leftMax(int[] arr,int idx,int n){
        if(idx==n)return;
        arr[idx]=Math.max(arr[idx],arr[idx-1]);
        leftMax(arr,idx+1,n);
    }
}
