import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextInt();
        }
        System.out.print(max(arr,0,n));
    }
    private static int max(int[] arr,int idx,int n){
        if(idx==n-1)return arr[idx];
        int maximum=max(arr,idx+1,n);
        return Math.max(arr[idx],maximum);
    }
}
