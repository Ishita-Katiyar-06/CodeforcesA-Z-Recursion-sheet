import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s= new Scanner(System.in);
        int start=s.nextInt();
        int end=s.nextInt();
        System.out.println(numberOfWays(start,end));
    }
    private static int numberOfWays(int start,int end){
        if(start==end)return 1;
        if(start>end)return 0;
        int skipOne=numberOfWays(start+1,end);
        int skipTwo=numberOfWays(start+2,end);
        int skipThree=numberOfWays(start+3,end);
        return skipOne+skipTwo+skipThree;
    }
}
