import java.util.*;
public class Main{
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        invPyramid(n,1);
    }
    private static void invPyramid(int n,int row) {
        if(row>n)return;
        for(int i=0; i<row-1;i++)System.out.print(" ");
        for(int i=0; i<2*(n-row)+1;i++)System.out.print("*");
        System.out.println();
        invPyramid(n,row+1);
    }
}
