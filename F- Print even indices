import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        int[] arr=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=s.nextInt();
        }
        printEvenIndices(arr,n,0);
    }
    private static void printEvenIndices(int[] arr, int n,int idx){
        if(idx==n)return;
        printEvenIndices(arr,n,idx+1);
        if(idx%2==0)System.out.print(arr[idx]+" ");
    }
}
