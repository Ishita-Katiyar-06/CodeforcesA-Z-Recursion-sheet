import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        printNumbers(n);
    }
    private static void printNumbers(int n){
        if(n==0)return;
        printNumbers(n-1);
        System.out.println(n);
    }
}
