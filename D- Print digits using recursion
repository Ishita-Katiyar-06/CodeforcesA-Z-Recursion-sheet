import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        for (int i = 0; i < n; i++) {
            int num = s.nextInt();
            if (num == 0) {
                System.out.print("0 ");
            } else {
                printNumbers(num);
            }
            System.out.println();
        }
    }
    private static void printNumbers(int num) {
        if (num < 1) return;
        printNumbers(num / 10);
        System.out.print(num % 10 + " ");
    }
}
