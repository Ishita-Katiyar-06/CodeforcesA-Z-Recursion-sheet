import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        for(int i=0;i<n;i++){
            int num=s.nextInt();
            printBinary(num);
            System.out.println();
        }
    }
    private static void printBinary(int n){
        if(n==0)return;
        printBinary(n/2);
        System.out.print(n%2);
    }
}
