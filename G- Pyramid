import java.util.*;
public class Main{
    static void printPyramid(int n,int row) {
        if(row>n)return;
        for(int i=0;i<n-row;i++)System.out.print(" ");
        for (int i=0;i<2*row-1;i++)System.out.print("*");
        System.out.println();
        printPyramid(n,row+1);
    }
    public static void main(String[] args) {
        Scanner s=new Scanner(System.in);
        int n=s.nextInt();
        printPyramid(n,1);
    }
}
