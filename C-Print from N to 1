import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();
        printNumbers(n);
    }
    private static void printNumbers(int n) {
        if (n == 0) return;
        System.out.print(n);
        if (n > 1) {
            System.out.print(" ");
        }
        printNumbers(n - 1);
    }
}
